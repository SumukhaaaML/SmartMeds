# Frontend Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to Git

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=smartmeds-9b931.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smartmeds-9b931
VITE_FIREBASE_STORAGE_BUCKET=smartmeds-9b931.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://smartmeds-9b931-default-rtdb.firebaseio.com

# Backend API
VITE_BACKEND_URL=http://127.0.0.1:5000

# Environment
VITE_ENV=development
