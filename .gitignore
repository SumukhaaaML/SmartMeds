# ============================================================
# SmartMeds – Root .gitignore
# ============================================================

# ── Node / JS ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tgz

# ── Build / Dist ───────────────────────────────────────────
dist/
build/
web-build/
.next/
out/

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
*.egg

# ── Environment / Secrets ──────────────────────────────────
# !! CRITICAL: NEVER COMMIT .env FILES WITH REAL CREDENTIALS !!
.env
.env.*
**/.env
**/.env.*
!**/.env.example     # keep example templates
*.local

# ── Firebase Credentials (NEVER commit) ────────────────────
*serviceAccountKey*.json
*service-account*.json
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# ── Expo / React Native ────────────────────────────────────
.expo/
.expo-shared/
.jsc/
ios/Pods/
ios/build/
android/build/
android/.gradle/
android/app/build/
*.keystore
!debug.keystore

# ── Uploads / Generated Files ──────────────────────────────
uploads/
*.log

# ── macOS ──────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
__MACOSX/

# ── IDE / Editors ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── VS Code Local History Extension ────────────────────────
# This extension stores file snapshots with timestamps which
# can inadvertently contain secrets you've since removed.
.history/
**/.history/

# ── Testing / Coverage ─────────────────────────────────────
coverage/
.pytest_cache/
htmlcov/
.cache/

# ── Misc ───────────────────────────────────────────────────
*.orig
*.bak
Thumbs.db
