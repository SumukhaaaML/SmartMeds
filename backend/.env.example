APP_ENV=production
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://your-frontend.example.com

# Security
REQUIRE_API_KEY=true
SMARTMEDS_API_KEY=replace-with-a-strong-random-key

# Request limits
MAX_UPLOAD_SIZE_MB=15

# Rate limiter storage (use Redis in production)
RATE_LIMIT_STORAGE_URI=memory://

# Firebase
FIREBASE_DATABASE_URL=https://smartmeds-9b931-default-rtdb.firebaseio.com
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccountKey.json

# Scheduler: disable in multi-worker web processes; run in a dedicated worker instead
ENABLE_SCHEDULER=false
